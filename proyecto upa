const express = require("express");
const sqlite3 = require("sqlite3").verbose();
const crypto = require("crypto");

const app = express();
app.use(express.json());

const db = new sqlite3.Database("./tienda.db");

// Crear tablas
db.serialize(() => {
    db.run(`
        CREATE TABLE IF NOT EXISTS clientes (
            id TEXT PRIMARY KEY,
            nombre TEXT NOT NULL,
            telefono TEXT,
            email TEXT
        )
    `);

    db.run(`
        CREATE TABLE IF NOT EXISTS proveedores (
            id TEXT PRIMARY KEY,
            nombre TEXT NOT NULL,
            telefono TEXT,
            email TEXT
        )
    `);
});

// Generar ID único
function generarID(prefijo) {
    return prefijo + "-" + crypto.randomBytes(4).toString("hex").toUpperCase();
}

// ==================== CLIENTES ====================

// Crear cliente
app.post("/clientes", (req, res) => {
    const { nombre, telefono, email } = req.body;
    const id = generarID("CLI");

    db.run(
        "INSERT INTO clientes (id, nombre, telefono, email) VALUES (?, ?, ?, ?)",
        [id, nombre, telefono, email],
        function(err) {
            if (err) {
                return res.status(500).json({ error: err.message });
            }
            res.json({ mensaje: "Cliente creado", id });
        }
    );
});

// Ver clientes
app.get("/clientes", (req, res) => {
    db.all("SELECT * FROM clientes", [], (err, rows) => {
        if (err) return res.status(500).json({ error: err.message });
        res.json(rows);
    });
});

// ==================== PROVEEDORES ====================

// Crear proveedor
app.post("/proveedores", (req, res) => {
    const { nombre, telefono, email } = req.body;
    const id = generarID("PRO");

    db.run(
        "INSERT INTO proveedores (id, nombre, telefono, email) VALUES (?, ?, ?, ?)",
        [id, nombre, telefono, email],
        function(err) {
            if (err) {
                return res.status(500).json({ error: err.message });
            }
            res.json({ mensaje: "Proveedor creado", id });
        }
    );
});

// Ver proveedores
app.get("/proveedores", (req, res) => {
    db.all("SELECT * FROM proveedores", [], (err, rows) => {
        if (err) return res.status(500).json({ error: err.message });
        res.json(rows);
    });
});

// ==================== INICIO ====================

const PORT = 3000;
app.listen(PORT, () => {
    console.log(`Servidor ejecutándose en http://localhost:${PORT}`);
});
